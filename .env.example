# ==============================================================================
# Aurevia Motors — Environment Configuration Template
# Copy this file to '.env' for local development. Never commit '.env' to git.
# ==============================================================================

# Environment profile: 'development' (default) or 'production'
DJANGO_ENV=development

# Django Secret Key (generate a unique cryptographically strong key for production)
DJANGO_SECRET_KEY=django-insecure-aurevia-dev-key-change-in-production

# Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of host/domain names)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# Database Configuration (defaults to local SQLite db.sqlite3 if omitted)
# DATABASE_URL=sqlite:///db.sqlite3

# Future Payment & Notification Integrations (Placeholders for later phases)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# ETHEREUM_RPC_URL=
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
