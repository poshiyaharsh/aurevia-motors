# ==============================================================================
# Aurevia Motors — Environment Configuration Template
# Copy this file to '.env' for local development. Never commit '.env' to git.
# ==============================================================================

# Django Secret Key (generate a unique random key for production)
DJANGO_SECRET_KEY=django-insecure-aurevia-dev-key-change-in-production

# Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of host/domain names)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (defaults to SQLite if not provided)
# DATABASE_URL=sqlite:///db.sqlite3
